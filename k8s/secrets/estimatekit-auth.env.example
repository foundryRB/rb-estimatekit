# k8s-target: namespace=estimatekit, name=estimatekit-auth, type=Opaque
# The app's HTTP Basic credential for its /mcp machine door (fails closed until this
# Secret exists). Copy to k8s/secrets/estimatekit-auth.env (git-ignored), fill the values, and
# apply with the platform's seed/apply-secrets.sh. Never commit the real file.
ESTIMATEKIT_AUTH_USER=
ESTIMATEKIT_AUTH_PASSWORD=
