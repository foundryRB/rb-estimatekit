@startuml architecture-overview
!define RECTANGLE rectangle
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho

title [PROJECT NAME] - System Overview - Phase 1

/'==============================
  ACTORS
=============================='/
actor "End User" as User #LightBlue
actor "Admin" as Admin #LightGreen

/'==============================
  FRONTEND LAYER
=============================='/
package "Frontend Layer" as FrontendLayer #E3F2FD {
    [Web Application] as WebApp
    [Admin Panel] as AdminPanel
}

/'==============================
  BACKEND LAYER
=============================='/
package "Backend Layer" as BackendLayer #E8F5E9 {
    [API Gateway] as API
    [Business Logic] as BizLogic
    [Auth Service] as Auth
    [External API Adapter] as ExtAdapter
}

/'==============================
  DATA LAYER
=============================='/
package "Data Layer" as DataLayer #FFF3E0 {
    database "Database" as DB
    database "Cache" as Cache
}

/'==============================
  EXTERNAL SYSTEMS
=============================='/
package "External Systems" as External #F3E5F5 {
    [Third-Party API] as ExtAPI
}

/'==============================
  RELATIONSHIPS
=============================='/
User --> WebApp
Admin --> AdminPanel
WebApp --> API
AdminPanel --> API
API --> Auth
API --> BizLogic
BizLogic --> DB
BizLogic --> Cache
BizLogic --> ExtAdapter
ExtAdapter --> ExtAPI

@enduml
