# Local development settings for estimatekit. Copy to .env (git-ignored) and fill in.
# Never commit real values. In the cluster these come from Kubernetes Secrets instead
# (see k8s/secrets/*.env.example).
# Set to true only for local development without a login.
ESTIMATEKIT_AUTH_DISABLED=
ESTIMATEKIT_AUTH_USER=
ESTIMATEKIT_AUTH_PASSWORD=
